# Copy this file to .env.local and fill in your values. .env.local is gitignored.
# Supabase dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The PUBLISHABLE key only. Never put a secret or service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me_with_your_key
